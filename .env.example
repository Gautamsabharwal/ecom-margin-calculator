# Copy to .env for local `netlify dev` only. This file has no real values
# and is safe to commit. The live site reads these from Netlify's own
# environment variable store (Site configuration > Environment variables),
# not from this file.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=consciouschemist.com
SESSION_SECRET=
APP_BASE_URL=http://localhost:8888
